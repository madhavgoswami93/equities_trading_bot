# Copy to .env (git-ignored) and fill in only the provider(s) you use.

# --- Zerodha Kite Connect (developers.kite.trade; "Connect" plan for historical data)
KITE_API_KEY=
KITE_API_SECRET=
# Optional: otherwise `python -m swingbot kite-login` stores it in .secrets/kite_access_token
KITE_ACCESS_TOKEN=

# --- Groww Trade API (groww.in/trade-api; paid plan for historical candles)
GROWW_API_KEY=
# either TOTP secret (recommended, no daily approval) ...
GROWW_TOTP_SECRET=
# ... or API secret (approve daily on the Groww Cloud API keys page)
GROWW_API_SECRET=
# or a ready-made token
GROWW_ACCESS_TOKEN=

# --- Telegram alerts (optional; [alerts] telegram = true in the strategy file)
# create a bot with @BotFather, message it once, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
